{
  "name": "flowai",
  "version": "1.0.0",
  "description": "FlowAI - Modern AI Workflow Automation Engine",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev:server": "node backend/server.js",
    "dev:client": "npm.cmd --prefix frontend run dev",
    "build:client": "npm.cmd --prefix frontend run build",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
}
